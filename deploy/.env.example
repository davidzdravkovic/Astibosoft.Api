# Copy to .env and fill in. Never commit .env.

# Infra Postgres admin (same credentials as FitCore / ChatMe / Hardliq on this VPS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astibosoft

# Public site origin (optional CORS allow-list entry).
PUBLIC_ORIGIN=https://astibosoft.com

# JWT — at least 32 characters
# openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=480

# Founder admins (seeded once on startup if email not present)
FOUNDER1_EMAIL=you@astibosoft.com
FOUNDER1_PASSWORD=change-me-strong-password
FOUNDER1_NAME=David

FOUNDER2_EMAIL=partner@astibosoft.com
FOUNDER2_PASSWORD=change-me-strong-password
FOUNDER2_NAME=Partner
