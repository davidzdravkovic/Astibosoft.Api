# Copy to .env and fill in. Never commit .env.

# Infra Postgres admin (same credentials as FitCore / ChatMe / Hardliq on this VPS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astibosoft

# Public site origin (optional CORS allow-list entry).
PUBLIC_ORIGIN=https://astibosoft.com

# Path to Astibosoft.Ai checkout used as Docker build context
# VPS default: sibling of Astibosoft.Api → ../../Astibosoft.Ai from deploy/
# ASTIBOSOFT_AI_CONTEXT=/home/ubuntu/Astibosoft.Ai

# Astibosoft.Ai — published on 127.0.0.1:8090 for CLI embed
AI_HOST_PORT=8090
AI_BASE_URL=http://astibosoft-ai:8090
AI_INTERNAL_KEY=change-me-shared-internal-key
AI_TIMEOUT_SECONDS=60
AI_EMBED_ON_START=false

# LLM on the Ai container (not the API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# JWT — at least 32 characters
# openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=480

# Founder admins (seeded once on startup if email not present)
FOUNDER1_EMAIL=you@astibosoft.com
FOUNDER1_PASSWORD=change-me-strong-password
FOUNDER1_NAME=David

FOUNDER2_EMAIL=partner@astibosoft.com
FOUNDER2_PASSWORD=change-me-strong-password
FOUNDER2_NAME=Partner
